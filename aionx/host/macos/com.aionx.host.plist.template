<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AionX host: aioncore serves the API and the built web client itself (ADR-002), no Node runtime.
  Rendered by install.sh; placeholders: __HOME__, __AIONCORE__, __STATIC_DIR__, __DATA_DIR__, __PORT__.
  launchd gives the host a clean environment: no variables leak in from the shell or agent session
  that installed it.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aionx.host</string>

  <key>ProgramArguments</key>
  <array>
    <string>__AIONCORE__</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>__PORT__</string>
    <string>--data-dir</string>
    <string>__DATA_DIR__</string>
    <string>--static-dir</string>
    <string>__STATIC_DIR__</string>
    <string>--log-level</string>
    <string>info</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <!-- Agent CLIs (claude, codex, gemini) are looked up on this PATH. -->
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Keep agents' git from walking up into an accidental repo at $HOME. -->
    <key>GIT_CEILING_DIRECTORIES</key>
    <string>__HOME__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__DATA_DIR__/../logs/host.out.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA_DIR__/../logs/host.err.log</string>
</dict>
</plist>
